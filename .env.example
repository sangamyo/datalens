# Copy to .env and change the passwords. Never commit .env.

# Postgres (used by the db container)
POSTGRES_USER=episodehub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=episodehub

# Used by the api/worker containers ("db" is the compose service name)
DATABASE_URL=postgresql+psycopg://episodehub:change-me@db:5432/episodehub
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-too
S3_BUCKET=episodehub
