# Copy to .env and change the passwords. Never commit .env.

# Postgres (used by the db container)
POSTGRES_USER=datalens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datalens

# Used by the api/worker containers ("db" is the compose service name).
# From the host (alembic, psql) use the published port instead: localhost:5434
# (5432 is left alone because a local Postgres often owns it).
DATABASE_URL=postgresql+psycopg://datalens:change-me@db:5432/datalens
REDIS_URL=redis://redis:6379/0

# S3-compatible object storage (SeaweedFS service "s3")
S3_ENDPOINT_URL=http://s3:8333
S3_ACCESS_KEY=datalens
S3_SECRET_KEY=change-me-too
S3_BUCKET=datalens

# Optional: Hugging Face token (public datasets don't need it)
HF_TOKEN=
# Optional: LLM for natural-language search (rule-based parser is used if both are empty)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
